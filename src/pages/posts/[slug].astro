---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, getPostContent } from '../../lib/notion';
import type { Post } from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const html = await getPostContent(post.id);
---

<Layout title={post.title} description={post.description} ogImage={post.cover}>
  <article>
    <header class="mb-12">
      <a
        href="/"
        class="text-sm text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        ← 목록
      </a>

      <div class="flex items-baseline gap-3 mt-8 mb-4">
        <time class="text-sm text-neutral-400 dark:text-neutral-500 tabular-nums">
          {post.date}
        </time>
        <span class="text-sm text-neutral-400 dark:text-neutral-500 uppercase tracking-widest">
          {post.category}
        </span>
      </div>

      <h1 class="text-4xl font-semibold leading-tight tracking-tight">
        {post.title}
      </h1>

      {post.description && (
        <p class="mt-4 text-lg text-neutral-500 dark:text-neutral-400 leading-relaxed">
          {post.description}
        </p>
      )}

      {post.cover && (
        <img
          src={post.cover}
          alt={post.album ?? post.title}
          class="w-full mt-10 aspect-square object-cover"
          referrerpolicy="no-referrer"
        />
      )}

      {(post.artist || post.album || post.rating !== undefined) && (
        <div class="mt-6 pb-8 border-b border-neutral-200 dark:border-neutral-800">
          {post.artist && (
            <p class="text-lg font-semibold">{post.artist}</p>
          )}
          {post.album && (
            <p class="text-neutral-500 dark:text-neutral-400 font-serif italic">
              {post.album}
            </p>
          )}
          {post.rating !== undefined && (
            <p class="mt-2 text-3xl font-light tabular-nums">
              {post.rating}<span class="text-base text-neutral-400"> / 10</span>
            </p>
          )}
        </div>
      )}

      {post.tags.length > 0 && (
        <div class="flex gap-4 mt-4">
          {post.tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="text-sm text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose-editorial text-neutral-800 dark:text-neutral-200" set:html={html} />
  </article>
</Layout>
